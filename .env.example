# Copy to .env for local overrides. Defaults live in src/config/env.ts.
NODE_ENV=development
PORT=3000
# Direct Bun/executable listener. CLI --host takes precedence.
# Compose sets its container listener explicitly; use INVOICE_BIND_ADDRESS below
# to control the published host interface instead.
INVOICE_HOST=127.0.0.1

# Prebuilt-image Compose deployment only. Pin a released version; do not use
# `latest` for upgrades that contain database migrations.
INVOICE_IMAGE_TAG=0.2.0
# App is intentionally unauthenticated. Use 0.0.0.0 only behind an
# authenticated reverse proxy or on a trusted LAN.
INVOICE_BIND_ADDRESS=127.0.0.1

DATA_DIR=./data
DB_PATH=./data/app.db
FILES_DIR=./data/files
TMP_DIR=./data/tmp

# Optional HTML-to-PDF engine. Leave blank to keep the lightweight React PDF-only setup.
GOTENBERG_URL=
GOTENBERG_TIMEOUT_MS=15000
