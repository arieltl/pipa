{
  "name": "pipa",
  "version": "0.3.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:vendor && concurrently -k -n css,server -c cyan,green \"bun run dev:css\" \"bun run dev:server\"",
    "dev:server": "bun run --hot src/index.tsx",
    "dev:css": "bun run build:css -- --watch",
    "build": "bun run build:vendor && bun run build:css && bun run build:runtime",
    "build:css": "bunx @tailwindcss/cli -i assets/main.css -o src/public/app.css --minify",
    "build:vendor": "bun run scripts/copy-vendor.ts",
    "build:runtime": "bun run scripts/generate-embedded-runtime.ts",
    "build:binary": "bun run build && bun build --compile --minify --sourcemap --bytecode --target=bun-linux-x64-baseline src/index.tsx --outfile dist/invoice",
    "start": "bun run src/index.tsx",
    "typecheck": "bunx tsc --noEmit",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:studio": "bunx drizzle-kit studio",
    "test": "bun run build && bun run test:unit",
    "test:unit": "bun test"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.32.0",
    "@react-pdf/renderer": "^4.5.1",
    "@types/react": "^19.2.17",
    "css-tree": "^3.2.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "hono": "^4.12.26",
    "liquidjs": "^10.24.0",
    "parse5": "^8.0.1",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.3",
    "@tailwindcss/cli": "^4.3.1",
    "@types/bun": "^1.3.14",
    "@types/css-tree": "^3.2.0",
    "alpinejs": "^3.15.12",
    "concurrently": "^10.0.3",
    "daisyui": "^5.5.23",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.10.6",
    "htmx.org": "^2.0.10",
    "pdfjs-dist": "^6.3.289",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  }
}
